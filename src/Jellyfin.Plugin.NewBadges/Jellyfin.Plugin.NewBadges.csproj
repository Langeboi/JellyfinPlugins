<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.NewBadges</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.NewBadges</RootNamespace>
    <Version>2.6.2.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Common" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Data" Version="12.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Inject\inject.js" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <!--
      Kept so an existing install can keep pointing HeaderLogoUrl at
      /NewBadges/langehub_logo.png. Nothing references it unless that setting
      is filled in, so a fresh install never shows it.
    -->
    <EmbeddedResource Include="Inject\langehub_logo.png" />
  </ItemGroup>

</Project>

